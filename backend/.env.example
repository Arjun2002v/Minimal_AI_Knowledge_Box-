# Gemini (used through LangChain). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
CHAT_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
# Changing the embedding model or dimensions means existing chunks must be re-embedded
# (delete data/inbox.db and save your items again).
EMBEDDING_DIMENSIONS=768

PORT=4000
DB_PATH=./data/inbox.db
# Chunk size and overlap are in characters.
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
# LOG_LEVEL=info
